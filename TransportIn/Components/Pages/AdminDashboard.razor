    // ===== ПРАЦІВНИКИ =====
    private void SaveEmployee()
    {
        empErrors.Clear();
        bool isNew = editingEmployeeId == null;

        void Check(string key, string? val, Func<string, bool> ok, string msg, bool required)
        {
            if (string.IsNullOrWhiteSpace(val)) { if (required) empErrors[key] = "Обов'язкове поле"; return; }
            if (!ok(val)) empErrors[key] = msg;
        }

        var phone = NormPhone(newEmp.Phone);
        var passport = NormUpper(newEmp.PassportNo);
        var labor = NormUpper(newEmp.LaborBookNo);
        var diploma = NormUpper(newEmp.DiplomaNo);
        var driverLic = NormLatin(newEmp.DriverLicenseNo);
        bool isDriver = newEmp.Role == "Водій";

        Check("LastName", newEmp.LastName, _ => true, "", true);
        Check("FirstName", newEmp.FirstName, _ => true, "", true);
        Check("Login", newEmp.Login, s => s.Trim().Length >= 3, "Мінімум 3 символи", isNew);
        Check("Password", newEmp.Password, s => s.Length >= 6, "Мінімум 6 символів", isNew);
        Check("Phone", phone, s => RxPhone.IsMatch(s), "Телефон: 10 цифр, починається з 0", true);
        Check("Email", newEmp.Email, s => RxEmail.IsMatch(s.Trim()), "Невірний email", isNew);

        if (newEmp.PassportType == "Книжка")
            Check("PassportNo", passport, s => RxPassBook.IsMatch(s), "2 літери + 6 цифр", isNew);
        else
            Check("PassportNo", passport, s => RxIdCard.IsMatch(s), "9 цифр", isNew);
        Check("Unzr", newEmp.Unzr?.Trim(), s => RxUnzr.IsMatch(s), "Формат РРРРММДД-ХХХХХ", isNew);
        Check("Ipn", newEmp.Ipn?.Trim(), s => RxIpn.IsMatch(s), "10 цифр", isNew);

        Check("LaborBookNo", labor, s => RxLabor.IsMatch(s), "2 літери + 7 цифр", false);
        Check("DiplomaNo", diploma, s => RxDiploma.IsMatch(s), "2 літери + 6 цифр", isNew);

        Check("MedNo", newEmp.MedNo, _ => true, "", isNew);
        Check("MedExpiry", newEmp.MedExpiry, s => ValidDate(s), "Формат: ДД.ММ.РРРР", true);
        Check("DriverLicenseNo", driverLic, s => RxDriverLic.IsMatch(s), "3 літери + 6 цифр", isNew && isDriver);
        Check("LicenseCategory", newEmp.LicenseCategory, _ => true, "", isDriver);
        Check("LicenseExpiry", newEmp.LicenseExpiry, s => ValidDate(s), "Формат: ДД.ММ.РРРР", false);

        if (!empErrors.ContainsKey("Phone") &&
            EmployeeService.GetAllEmployees().Any(e => e.Id != editingEmployeeId && e.Phone == phone))
            empErrors["Phone"] = "Співробітник з таким телефоном вже існує!";

        if (empErrors.Count > 0)
        {
            empTab = empErrors.Keys.Select(k => EmpTabOf.GetValueOrDefault(k, "main")).OrderBy(t => Array.IndexOf(EmpTabOrder, t)).First();
            return;
        }

        var fullName = $"{newEmp.LastName.Trim()} {newEmp.FirstName.Trim()} {newEmp.MiddleName?.Trim()}".Trim();

        try
        {
            if (editingEmployeeId != null)
            {
                var e = EmployeeService.GetAllEmployees().FirstOrDefault(x => x.Id == editingEmployeeId);
                if (e == null) { SetFlash("Працівника більше не існує.", true); CancelEmployeeEdit(); return; }
                e.FullName = fullName;
                e.Role = newEmp.Role;
                e.Phone = phone;
                e.LicenseCategory = newEmp.LicenseCategory?.Trim() ?? "";
                e.MedicalCertExpiry = newEmp.MedExpiry.Trim();
                SetFlash($"Дані «{fullName}» оновлено.");
            }
            else
            {
                EmployeeService.AddEmployee(new TransportIn.Services.Employee
                    {
                        FullName = fullName,
                        Role = newEmp.Role,
                        Phone = phone,
                        LicenseCategory = newEmp.LicenseCategory?.Trim() ?? "",
                        MedicalCertExpiry = newEmp.MedExpiry.Trim(),
                        IsActive = true
                    });
                SetFlash($"Працівника «{fullName}» додано.");
            }
        }
        catch (Exception ex) { SetFlash("Не вдалося зберегти працівника: " + ex.Message, true); return; }

        CancelEmployeeEdit();
    }

    private void EditEmployee(TransportIn.Services.Employee e)
    {
        empErrors.Clear();
        editingEmployeeId = e.Id;
        var parts = (e.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        newEmp = new EmployeeForm
            {
                LastName = parts.Length > 0 ? parts[0] : "",
                FirstName = parts.Length > 1 ? parts[1] : "",
                MiddleName = parts.Length > 2 ? string.Join(" ", parts.Skip(2)) : "",
                Role = e.Role ?? "Водій",
                Phone = e.Phone ?? "",
                LicenseCategory = e.LicenseCategory ?? "",
                MedExpiry = e.MedicalCertExpiry ?? ""
            };
        empTab = "main";
    }

    private void CancelEmployeeEdit()
    {
        editingEmployeeId = null;
        newEmp = new();
        empErrors.Clear();
        empTab = "main";
    }

    private void ToggleBlock(TransportIn.Services.Employee e)
    {
        if (IsSelf(e)) return;
        e.IsActive = !e.IsActive;
        SetFlash(e.IsActive ? $"«{e.FullName}» розблоковано." : $"«{e.FullName}» заблоковано.");
    }

    private string GetDocStatus(string? dateStr)
    {
        if (string.IsNullOrWhiteSpace(dateStr)) return "ok";
        if (DateTime.TryParseExact(dateStr, "dd.MM.yyyy", null, System.Globalization.DateTimeStyles.None, out var date))
        {
            var daysLeft = (date.Date - DateTime.Today).TotalDays;
            if (daysLeft < 0) return "expired";
            if (daysLeft <= 30) return "warning";
        }
        return "ok";
    }

    private string GetDocIcon(string? dateStr) => GetDocStatus(dateStr) switch
    {
        "expired" => "bi-x-circle-fill",
        "warning" => "bi-exclamation-circle-fill",
        _ => "bi-check-circle-fill"
    };

