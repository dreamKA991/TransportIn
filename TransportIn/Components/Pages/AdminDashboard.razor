                                            <td><strong>@emp.FullName</strong>@(self ? " (ви)" : "")</td>
                                            <td><span class="badge-modern badge-secondary">@emp.Role</span></td>
                                            <td>@emp.Phone</td>
                                            <td>
                                                <span class="doc-status @GetDocStatus(emp.MedicalCertExpiry)">
                                                    <i class="bi @GetDocIcon(emp.MedicalCertExpiry)"></i> @(string.IsNullOrEmpty(emp.MedicalCertExpiry) ? "—" : emp.MedicalCertExpiry)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="doc-status ok">
                                                    <i class="bi bi-check-circle-fill"></i> @(string.IsNullOrEmpty(emp.LicenseCategory) ? "—" : emp.LicenseCategory)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge-modern @(emp.IsActive ? "badge-success" : "badge-danger")">
                                                    <i class="bi @(emp.IsActive ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i> @(emp.IsActive ? "Активний" : "Заблокований")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="row-actions">
                                                    <button class="btn-icon" title="Редагувати" @onclick='() => EditEmployee(emp)'><i class="bi bi-pencil"></i></button>
                                                    <button class="btn-icon warn" title="@(emp.IsActive ? "Блокувати" : "Розблокувати")" disabled="@self" @onclick='() => ToggleBlock(emp)'><i class="bi @(emp.IsActive ? "bi-lock" : "bi-unlock")"></i></button>
                                                    <button class="btn-icon danger" title="Видалити" disabled="@self" @onclick='() => ConfirmDelete(emp.FullName, () => DeleteEmployee(emp.Id))'><i class="bi bi-trash"></i></button>
                                                </div>
