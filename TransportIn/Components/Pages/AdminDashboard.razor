                </div>
            </div>

            <!-- ============ ЕКСПЕРТНІ ПРАВИЛА ============ -->
            <div class="modern-card">
                <div class="card-header-custom">
                    <h5><span class="header-icon amber"><i class="bi bi-brain"></i></span> База експертних знань</h5>
                    <span class="badge-count">@ExpertRulesService.GetAllRules().Count правил</span>
                </div>
                <div class="card-body-custom">
                    <div class="form-add-row">
                        <div class="row g-3 align-items-start">
                            <div class="col-lg-2 col-md-4"><label class="form-label-modern">Тип загрози *</label><input class="dark-input w-100 @RuleErr("ThreatType")" @bind="newRule.ThreatType" placeholder="Повітряна тривога" />@RuleMsg("ThreatType")</div>
                            <div class="col-lg-3 col-md-4"><label class="form-label-modern">Умова *</label><input class="dark-input w-100 @RuleErr("Condition")" @bind="newRule.Condition" placeholder="Тривога в регіоні" />@RuleMsg("Condition")</div>
                            <div class="col-lg-3 col-md-4"><label class="form-label-modern">Рекомендація *</label><input class="dark-input w-100 @RuleErr("Action")" @bind="newRule.ActionRecommendation" placeholder="Зупинити рух" />@RuleMsg("Action")</div>
                            <div class="col-lg-2 col-md-6">
                                <label class="form-label-modern">Пріоритет</label>
                                <select class="dark-input w-100" @bind="newRule.Priority">
                                    <option value="Критичний">Критичний</option>
                                    <option value="Високий">Високий</option>
                                    <option value="Середній">Середній</option>
                                </select>
                            </div>
                            <div class="col-lg-2 col-md-6" style="padding-top:1.55rem"><button class="btn-modern btn-add w-100" @onclick="AddExpertRule"><i class="bi bi-plus-lg"></i> Додати</button></div>
                        </div>
                    </div>
                    @if (ExpertRulesService.GetAllRules().Count == 0)
                    {
                        <div class="text-center py-4" style="color:var(--text-secondary)">Правил ще немає.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="modern-table">
                                <thead><tr><th>Загроза</th><th>Умова</th><th>Рекомендація</th><th>Пріоритет</th><th>Дія</th></tr></thead>
                                <tbody>
                                    @foreach (var rule in ExpertRulesService.GetAllRules().ToList())
                                    {
                                        <tr>
                                            <td><strong>@rule.ThreatType</strong></td>
                                            <td>@rule.Condition</td>
                                            <td>@rule.ActionRecommendation</td>
                                            <td><span class="badge-modern @(rule.Priority == "Критичний" ? "badge-danger" : "badge-amber")"><i class="bi bi-flag-fill"></i> @rule.Priority</span></td>
                                            <td><button class="btn-modern btn-danger-modern" @onclick="() => ConfirmDelete(rule.ThreatType, () => ExpertRulesService.DeleteRule(rule.Id))"><i class="bi bi-trash"></i></button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </main>
</div>

<!-- ===== МОДАЛЬНЕ ВІКНО ПІДТВЕРДЖЕННЯ ВИДАЛЕННЯ ===== -->
@if (showDeleteModal)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h4><i class="bi bi-exclamation-triangle-fill" style="color:var(--danger-red)"></i> Підтвердження видалення</h4>
            <p>
                Ви впевнені, що хочете видалити <strong style="color:var(--text-primary)">@deleteTargetName</strong>?<br>
                Цю дію неможливо скасувати.
            </p>
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn-modern" style="background:var(--bg-input);color:var(--text-primary);border:1px solid var(--border-color)" @onclick="CancelDelete">Скасувати</button>
                <button class="btn-modern" style="background:var(--danger-red);color:white" @onclick="ExecuteDelete"><i class="bi bi-trash"></i> Видалити</button>
            </div>
        </div>
    </div>
}

@code {
    private string vehTab = "main";
    private string empTab = "main";
    private int? editingVehicleId;
    private int? editingEmployeeId;

    // ===== Повідомлення =====
    private string flash = "";
    private bool flashErr;
    private void SetFlash(string msg, bool err = false) { flash = msg; flashErr = err; }

    // ===== МОДАЛЬНЕ ВІКНО =====
    private bool showDeleteModal;
    private string deleteTargetName = "";
    private Action? deleteAction;

    // ===== ДОРОЖНІ ПОДІЇ =====
    private class RoadEventVM { public string Type = "ДТП"; public string Location = ""; public string Time = DateTime.Now.ToString("HH:mm"); }
    private List<RoadEventVM> roadEvents = new();
    private RoadEventVM newRoadEvent = new();
    private bool roadEventError;

    private class VehicleForm
    {
        public string BrandModel = ""; public string LicensePlate = ""; public string VinCode = ""; public string BodyType = "Тент";
        public double CapacityTons; public double VolumeM3; public bool HasRefrigerator; public bool HasStraps;
        public string AssignedDriver = ""; public string DriverSchedule = "Денний";
        public double ExtLength, ExtWidth, ExtHeight, IntLength, IntWidth, IntHeight, OwnMass, MaxWeight;
        public string TechPassport = ""; public string TechInspectNo = ""; public string TechInspectDate = "";
        public string LicenseNo = ""; public string LicenseStatus = "Активна"; public string Insurance = "";
    }
    private class EmployeeForm
    {
        public string FirstName = ""; public string LastName = ""; public string MiddleName = ""; public string Role = "Водій";
        public string Login = ""; public string Password = ""; public string Phone = ""; public string Email = "";
        public string PassportType = "Книжка"; public string PassportNo = ""; public string Unzr = ""; public string Ipn = "";
        public string LaborBookType = "Паперова"; public string LaborBookNo = ""; public string DiplomaNo = ""; public string EducationPlace = ""; public string EducationYear = "";
        public string MedNo = ""; public string MedExpiry = ""; public string DriverLicenseNo = ""; public string LicenseCategory = ""; public string LicenseExpiry = "";
        public string MilitaryDocNo = ""; public string Vus = ""; public string MilitaryRank = "";
    }

    private VehicleForm newVehicle = new();
    private EmployeeForm newEmp = new();
    private TransportIn.Services.ExpertRule newRule = new() { Priority = "Високий" };
    private Dictionary<string, string> vehErrors = new();
    private Dictionary<string, string> empErrors = new();
    private Dictionary<string, string> ruleErrors = new();

    // Усі формати допускають необов'язковий пробіл і кирилицю/латиницю (після нормалізації)
    private static readonly Regex RxEmail = new(@"^[^@\s]+@[^@\s]+\.[^@\s]+$");
    private static readonly Regex RxPhone = new(@"^0\d{9}$");
    private static readonly Regex RxVin = new(@"^[A-HJ-NPR-Z0-9]{17}$");
    private static readonly Regex RxPlate = new(@"^[A-Z]{2}\s?\d{4}\s?[A-Z]{2}$");
    private static readonly Regex RxTechPass = new(@"^[A-Z]{3}\s?\d{6}$");
    private static readonly Regex RxPassBook = new(@"^[A-ZА-ЯІЇЄҐ]{2}\s?\d{6}$");
    private static readonly Regex RxIdCard = new(@"^\d{9}$");
    private static readonly Regex RxUnzr = new(@"^\d{8}-\d{5}$");
    private static readonly Regex RxIpn = new(@"^\d{10}$");
    private static readonly Regex RxLabor = new(@"^[A-ZА-ЯІЇЄҐ]{2}\s?\d{7}$");
    private static readonly Regex RxDiploma = new(@"^[A-ZА-ЯІЇЄҐ]{2}\s?\d{6}$");
    private static readonly Regex RxDriverLic = new(@"^[A-Z]{3}\s?\d{6}$");

    private static readonly Dictionary<string, string> VehTabOf = new()
        {
            ["BrandModel"] = "main",
            ["LicensePlate"] = "main",
            ["VinCode"] = "main",
            ["CapacityTons"] = "dims",
            ["VolumeM3"] = "dims",
            ["TechPassport"] = "docs",
            ["TechInspectDate"] = "docs"
        };
    private static readonly Dictionary<string, string> EmpTabOf = new()
        {
            ["LastName"] = "main",
            ["FirstName"] = "main",
            ["Login"] = "main",
            ["Password"] = "main",
            ["Phone"] = "main",
            ["Email"] = "main",
            ["PassportNo"] = "passport",
            ["Unzr"] = "passport",
            ["Ipn"] = "passport",
            ["LaborBookNo"] = "labor",
            ["DiplomaNo"] = "labor",
            ["MedNo"] = "medical",
            ["MedExpiry"] = "medical",
            ["DriverLicenseNo"] = "medical",
            ["LicenseCategory"] = "medical",
            ["LicenseExpiry"] = "medical"
        };
    private static readonly string[] VehTabOrder = { "main", "dims", "docs" };
    private static readonly string[] EmpTabOrder = { "main", "passport", "labor", "medical", "military" };

    protected override void OnInitialized()
    {
        var userRole = AuthService.CurrentUser?.Role;
        if (userRole != TransportIn.Models.UserRole.Admin)
        {
            Navigation.NavigateTo(GetRedirectPath(userRole));
            return;
        }

        EmergencyService.OnChange += OnStateChanged;
        FleetService.OnChange += OnStateChanged;
        ExpertRulesService.OnChange += OnStateChanged;
        EmployeeService.OnChange += OnStateChanged;
    }
    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    // ===== НАВІГАЦІЯ =====
    private bool IsActive(string path) => Navigation.Uri.EndsWith(path, StringComparison.OrdinalIgnoreCase);

    private string GetRedirectPath(TransportIn.Models.UserRole? role) => role switch
    {
        TransportIn.Models.UserRole.Admin => "/admin-dashboard",
        TransportIn.Models.UserRole.Manager => "/manager-dashboard",
        TransportIn.Models.UserRole.Driver => "/driver-dashboard",
        _ => "/"
    };

    // ===== НОРМАЛІЗАЦІЯ ВВОДУ =====
    private static readonly Dictionary<char, char> Lookalike = new()
        {
            ['А'] = 'A',
            ['В'] = 'B',
            ['Е'] = 'E',
            ['К'] = 'K',
            ['М'] = 'M',
            ['Н'] = 'H',
            ['О'] = 'O',
            ['Р'] = 'P',
            ['С'] = 'C',
            ['Т'] = 'T',
            ['У'] = 'Y',
            ['Х'] = 'X',
            ['І'] = 'I'
        };
    // Кирилиця, схожа на латиницю → латиниця, верхній регістр
    private static string NormLatin(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        var up = s.Trim().ToUpperInvariant();
        return new string(up.Select(c => Lookalike.TryGetValue(c, out var l) ? l : c).ToArray());
    }
    private static string NormUpper(string? s) => string.IsNullOrWhiteSpace(s) ? "" : s.Trim().ToUpperInvariant();
    private static string NormPhone(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        var d = new string(s.Where(c => char.IsDigit(c) || c == '+').ToArray());
        if (d.StartsWith("+380")) d = "0" + d[4..];
        else if (d.StartsWith("380")) d = "0" + d[3..];
        return d;
    }
    private static bool ValidDate(string? s) =>
        DateTime.TryParseExact(s?.Trim(), "dd.MM.yyyy", null, System.Globalization.DateTimeStyles.None, out _);
    private static string FormatPlate(string p)
    {
        var c = p.Replace(" ", "");
        return $"{c[..2]} {c.Substring(2, 4)} {c[6..]}";
    }

    // ===== МОДАЛЬНЕ ВІКНО =====
    private void ConfirmDelete(string name, Action action)
    {
        deleteTargetName = name;
        deleteAction = action;
        showDeleteModal = true;
    }
    private void CancelDelete() { showDeleteModal = false; deleteAction = null; deleteTargetName = ""; }
    private void ExecuteDelete()
    {
        var name = deleteTargetName;
        try
        {
            deleteAction?.Invoke();
            SetFlash($"«{name}» видалено.");
        }
        catch (Exception ex) { SetFlash("Не вдалося видалити: " + ex.Message, true); }
        CancelDelete();
    }

    private void DeleteVehicle(int id)
    {
        FleetService.DeleteVehicle(id);
        if (editingVehicleId == id) CancelVehicleEdit();
    }
    private void DeleteEmployee(int id)
    {
        EmployeeService.DeleteEmployee(id);
        if (editingEmployeeId == id) CancelEmployeeEdit();
    }

    // ===== ДОРОЖНІ ПОДІЇ =====
    private void OnRoadEventKey(KeyboardEventArgs e) { if (e.Key == "Enter") AddRoadEvent(); }
    private void AddRoadEvent()
    {
        if (string.IsNullOrWhiteSpace(newRoadEvent.Location)) { roadEventError = true; return; }
        roadEventError = false;
        roadEvents.Insert(0, new RoadEventVM { Type = newRoadEvent.Type, Location = newRoadEvent.Location.Trim(), Time = DateTime.Now.ToString("HH:mm") });
        newRoadEvent = new RoadEventVM();
    }

    // ===== ВАЛІДАЦІЯ: хелпери для розмітки =====
    private string VehErr(string k) => vehErrors.ContainsKey(k) ? "is-invalid" : "";
    private string EmpErr(string k) => empErrors.ContainsKey(k) ? "is-invalid" : "";
    private string RuleErr(string k) => ruleErrors.ContainsKey(k) ? "is-invalid" : "";
    private static RenderFragment Msg(Dictionary<string, string> src, string k) => builder =>
    {
        if (src.TryGetValue(k, out var m))
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "invalid-feedback-modern");
            builder.AddContent(2, "⚠ " + m);
            builder.CloseElement();
        }
    };
    private RenderFragment VehMsg(string k) => Msg(vehErrors, k);
    private RenderFragment EmpMsg(string k) => Msg(empErrors, k);
    private RenderFragment RuleMsg(string k) => Msg(ruleErrors, k);

    private IEnumerable<string> DriverNames() =>
        EmployeeService.GetAllEmployees().Where(e => e.Role == "Водій" && !string.IsNullOrEmpty(e.FullName)).Select(e => e.FullName);

    private bool IsSelf(TransportIn.Services.Employee e) =>
        !string.IsNullOrEmpty(AuthService.CurrentUser?.FullName) &&
        string.Equals(e.FullName?.Trim(), AuthService.CurrentUser!.FullName.Trim(), StringComparison.OrdinalIgnoreCase);

    // ===== АВТОПАРК =====
    private bool IsVehicleDuplicate(string plate, string vin, int? exceptId)
    {
        var plateKey = plate.Replace(" ", "");
        return FleetService.GetAllVehicles().Any(v =>
            v.Id != exceptId &&
            (string.Equals((v.LicensePlate ?? "").Replace(" ", ""), plateKey, StringComparison.OrdinalIgnoreCase) ||
             string.Equals(v.VinCode ?? "", vin, StringComparison.OrdinalIgnoreCase)));
    }

    private void SaveVehicle()
    {
        vehErrors.Clear();
        var plate = NormLatin(newVehicle.LicensePlate);
        var vin = NormLatin(newVehicle.VinCode);
        var techPass = NormLatin(newVehicle.TechPassport);

        if (string.IsNullOrWhiteSpace(newVehicle.BrandModel)) vehErrors["BrandModel"] = "Обов'язкове поле";

        if (string.IsNullOrWhiteSpace(plate)) vehErrors["LicensePlate"] = "Обов'язкове поле";
        else if (!RxPlate.IsMatch(plate)) vehErrors["LicensePlate"] = "Невірний формат держномера (напр. AA 1234 BP)";

        if (string.IsNullOrWhiteSpace(vin)) vehErrors["VinCode"] = "Обов'язкове поле";
        else if (!RxVin.IsMatch(vin)) vehErrors["VinCode"] = "VIN: 17 символів без I, O, Q";

        if (newVehicle.CapacityTons <= 0) vehErrors["CapacityTons"] = "Має бути > 0";
        if (newVehicle.VolumeM3 <= 0) vehErrors["VolumeM3"] = "Має бути > 0";
        if (!string.IsNullOrWhiteSpace(techPass) && !RxTechPass.IsMatch(techPass)) vehErrors["TechPassport"] = "Формат: 3 літери + 6 цифр";
        if (!string.IsNullOrWhiteSpace(newVehicle.TechInspectDate) && !ValidDate(newVehicle.TechInspectDate)) vehErrors["TechInspectDate"] = "Формат: ДД.ММ.РРРР";

        if (!vehErrors.ContainsKey("LicensePlate") && !vehErrors.ContainsKey("VinCode") &&
            IsVehicleDuplicate(plate, vin, editingVehicleId))
            vehErrors["LicensePlate"] = "ТЗ з таким номером або VIN вже існує в базі!";

        if (vehErrors.Count > 0)
        {
            vehTab = vehErrors.Keys.Select(k => VehTabOf.GetValueOrDefault(k, "main")).OrderBy(t => Array.IndexOf(VehTabOrder, t)).First();
            return;
        }

        var formattedPlate = FormatPlate(plate);
        var hasFridge = newVehicle.HasRefrigerator || newVehicle.BodyType == "Рефрижератор";

        try
        {
            if (editingVehicleId != null)
            {
                var v = FleetService.GetAllVehicles().FirstOrDefault(x => x.Id == editingVehicleId);
                if (v == null) { SetFlash("ТЗ більше не існує.", true); CancelVehicleEdit(); return; }
                v.BrandModel = newVehicle.BrandModel.Trim();
                v.LicensePlate = formattedPlate;
                v.VinCode = vin;
                v.BodyType = newVehicle.BodyType;
                v.CapacityTons = newVehicle.CapacityTons;
                v.VolumeM3 = newVehicle.VolumeM3;
                v.HasRefrigerator = hasFridge;
                v.AssignedDriver = newVehicle.AssignedDriver ?? "";
                SetFlash($"ТЗ {formattedPlate} оновлено.");
            }
            else
            {
                FleetService.AddVehicle(new TransportIn.Models.Vehicle
                    {
                        BrandModel = newVehicle.BrandModel.Trim(),
                        LicensePlate = formattedPlate,
                        VinCode = vin,
                        BodyType = newVehicle.BodyType,
                        CapacityTons = newVehicle.CapacityTons,
                        VolumeM3 = newVehicle.VolumeM3,
                        HasRefrigerator = hasFridge,
                        AssignedDriver = newVehicle.AssignedDriver ?? ""
                    });
                SetFlash($"ТЗ {formattedPlate} додано.");
            }
        }
        catch (Exception ex) { SetFlash("Не вдалося зберегти ТЗ: " + ex.Message, true); return; }

        CancelVehicleEdit();
    }

