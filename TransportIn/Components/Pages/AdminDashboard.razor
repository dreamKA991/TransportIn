                                </div>
                                <div class="col-md-6"><label class="form-label-modern">Номер паспорта @(editingEmployeeId == null ? "*" : "")</label><input class="dark-input w-100 @EmpErr("PassportNo")" @bind="newEmp.PassportNo" placeholder="АН 123456 або 123456789" />@EmpMsg("PassportNo")</div>
                                <div class="col-md-6"><label class="form-label-modern">УНЗР @(editingEmployeeId == null ? "*" : "")</label><input class="dark-input w-100 @EmpErr("Unzr")" @bind="newEmp.Unzr" placeholder="19900101-12345" />@EmpMsg("Unzr")</div>
                                <div class="col-md-6"><label class="form-label-modern">РНОКПП (ІПН) @(editingEmployeeId == null ? "*" : "")</label><input class="dark-input w-100 @EmpErr("Ipn")" @bind="newEmp.Ipn" placeholder="3012345678" />@EmpMsg("Ipn")</div>
                            </div>
                        }
                        else if (empTab == "labor")
                        {
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label-modern">Трудова книжка</label>
                                    <select class="dark-input w-100" @bind="newEmp.LaborBookType"><option value="Паперова">Паперова</option><option value="Електронна">Електронна</option></select>
                                </div>
                                <div class="col-md-6"><label class="form-label-modern">Номер трудової</label><input class="dark-input w-100 @EmpErr("LaborBookNo")" @bind="newEmp.LaborBookNo" placeholder="БТ 7654321" />@EmpMsg("LaborBookNo")</div>
                                <div class="col-md-4"><label class="form-label-modern">Серія диплома @(editingEmployeeId == null ? "*" : "")</label><input class="dark-input w-100 @EmpErr("DiplomaNo")" @bind="newEmp.DiplomaNo" placeholder="ВК 123456" />@EmpMsg("DiplomaNo")</div>
                                <div class="col-md-4"><label class="form-label-modern">Назва закладу</label><input class="dark-input w-100" @bind="newEmp.EducationPlace" placeholder="КНУТЕУ" /></div>
                                <div class="col-md-4"><label class="form-label-modern">Рік закінчення</label><input class="dark-input w-100" @bind="newEmp.EducationYear" placeholder="2020" /></div>
                            </div>
