                    </div>

                    @{
                        var allEmployees = EmployeeService.GetAllEmployees();
                    }
                    @if (allEmployees.Count == 0)
                    {
                        <div class="text-center py-4" style="color:var(--text-secondary)">
                            <i class="bi bi-people" style="font-size:2.5rem;opacity:.35"></i>
