    private void SeedTestData()
    {
        try
        {
            var seed = new[]
            {
                ("Mercedes Sprinter", "AA 1234 BP", "WDB90663310123456", "Цільнометалічний фургон", 1.5, 14.0, false),
                ("Volvo FH16", "BC 0912 AK", "YV2A4A0C1KA123456", "Тент", 22.0, 86.0, false),
                ("MAN TGX", "AI 5678 CE", "WMA06XZZ2KM123456", "Рефрижератор", 20.0, 82.0, true),
            };
            foreach (var s in seed)
            {
                if (IsVehicleDuplicate(s.Item2, s.Item3, null)) continue;
                FleetService.AddVehicle(new TransportIn.Models.Vehicle
                    {
                        BrandModel = s.Item1,
                        LicensePlate = s.Item2,
                        VinCode = s.Item3,
                        BodyType = s.Item4,
                        CapacityTons = s.Item5,
                        VolumeM3 = s.Item6,
                        HasRefrigerator = s.Item7
                    });
            }

            if (!EmployeeService.GetAllEmployees().Any(e => e.Role == "Водій"))
            {
                var drivers = new[] { ("Коваленко І. П.", "0501111111"), ("Бондар В. М.", "0502222222"), ("Шевченко О. О.", "0503333333") };
                foreach (var d in drivers)
                    EmployeeService.AddEmployee(new TransportIn.Services.Employee
                        {
                            FullName = d.Item1,
                            Role = "Водій",
                            Phone = d.Item2,
                            LicenseCategory = "C, CE",
                            MedicalCertExpiry = "31.12.2027",
                            IsActive = true
                        });
            }
            SetFlash("Тестові дані додано.");
        }
        catch (Exception ex) { SetFlash("Не вдалося додати тестові дані: " + ex.Message, true); }
    }

    // ===== Експертні правила =====
    private void AddExpertRule()
    {
        ruleErrors.Clear();
        if (string.IsNullOrWhiteSpace(newRule.ThreatType)) ruleErrors["ThreatType"] = "Обов'язкове поле";
        if (string.IsNullOrWhiteSpace(newRule.Condition)) ruleErrors["Condition"] = "Обов'язкове поле";
        if (string.IsNullOrWhiteSpace(newRule.ActionRecommendation)) ruleErrors["Action"] = "Обов'язкове поле";
        if (ruleErrors.Count > 0) return;

        try
        {
            ExpertRulesService.AddRule(newRule);
            SetFlash($"Правило «{newRule.ThreatType}» додано.");
            newRule = new() { Priority = "Високий" };
        }
        catch (Exception ex) { SetFlash("Не вдалося додати правило: " + ex.Message, true); }
    }

