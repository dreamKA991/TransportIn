                                <div class="col-md-6"><label class="form-label-modern">Категорії @(newEmp.Role == "Водій" ? "*" : "")</label><input class="dark-input w-100 @EmpErr("LicenseCategory")" @bind="newEmp.LicenseCategory" placeholder="C, CE" />@EmpMsg("LicenseCategory")</div>
                                <div class="col-md-6"><label class="form-label-modern">Дійсне до</label><input class="dark-input w-100 @EmpErr("LicenseExpiry")" @bind="newEmp.LicenseExpiry" placeholder="ДД.ММ.РРРР" />@EmpMsg("LicenseExpiry")</div>
